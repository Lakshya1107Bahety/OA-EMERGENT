# Copy to frontend/.env for local development. On Vercel, set it under
# Project Settings > Environment Variables. It is baked in at build time.
REACT_APP_BACKEND_URL=http://localhost:8001

# Optional: run the Screening Flow (New Patient Assessment) against an
# in-browser mock instead of the backend, e.g. for demos without a server.
# Every result is then marked DEMO and nothing is saved to the database.
# Leave unset (or false) on Vercel.
# REACT_APP_MOCK_API=true
