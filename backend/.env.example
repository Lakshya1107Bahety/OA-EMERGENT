# Copy to backend/.env for local development. On Render, set these under
# Environment instead; never commit the real values.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=oa_sentinel

# Long random string used to sign login tokens, e.g. output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Flask ML API (oa-sentinel-api)
OA_API_URL=https://oa-sentinel-api-3.onrender.com

# Comma-separated frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Admin account created on first start. Not seeded if ADMIN_PASSWORD is empty.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
