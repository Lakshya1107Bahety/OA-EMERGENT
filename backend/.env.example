# Copy to backend/.env for local development. On Render, set these under
# Environment instead; never commit the real values.

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Optional locally: without it the backend uses an in-memory store saved to
# backend/data/local_db.json. On Render that file is wiped on every restart,
# so set a real MongoDB URL there.
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=oa_sentinel

# Long random string used to sign login tokens, e.g. output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Comma-separated frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Admin account created (or its password reset) on every start.
# If ADMIN_PASSWORD is not set, the password defaults to admin123.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
